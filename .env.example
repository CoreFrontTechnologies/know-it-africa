# Supabase public browser/server auth values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only Supabase key. Never expose this in client components.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Flutterwave keys
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_or_LIVE_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_or_LIVE_secret_key
# Optional for future webhooks
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# Site and contact configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=2349033222589
